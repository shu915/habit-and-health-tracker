# コピーして .env.local を作る(.env.local はコミットしない)
# docker-compose.yml のローカル専用 DB。ダミーの認証情報
DATABASE_URL=postgres://postgres:postgres@localhost:5433/habit_health

# Better Auth(マジックリンク)。開発中のメールはコンソール(next dev の端末)に出る。
# BETTER_AUTH_URL は本番だけで使う(開発は、アクセスしたアドレスから決まる)
BETTER_AUTH_URL=http://localhost:3000
# 必須(未設定だと起動時にエラー)。openssl rand -base64 32 などで作る
BETTER_AUTH_SECRET=

# ログインを許可するメールアドレス(ホワイトリスト)。カンマ区切り。
# 空のとき: 開発では全員許可、本番では誰も許可しない
ALLOWED_EMAILS=

# OpenRouter(モデル名は環境変数で切り替える)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# 食事の AI 推定の、1 日あたりの上限(1 以上の整数)。指定が無いとき: 開発サーバーは上限なし、本番とテストは 10 回
# MEAL_ESTIMATE_DAILY_LIMIT=

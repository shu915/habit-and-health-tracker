# コピーして .env.local を作る(.env.local はコミットしない)
# docker-compose.yml のローカル専用 DB。ダミーの認証情報
DATABASE_URL=postgres://postgres:postgres@localhost:5433/habit_health

# Better Auth(マジックリンク)。開発中のメールはコンソール(next dev の端末)に出る。
# BETTER_AUTH_URL は本番だけで使う(開発は、アクセスしたアドレスから決まる)
BETTER_AUTH_URL=http://localhost:3000
# 必須(未設定だと起動時にエラー)。openssl rand -base64 32 などで作る
BETTER_AUTH_SECRET=

# ログインを許可するメールアドレス(ホワイトリスト)。カンマ区切り。
# 空のとき: 開発では全員許可、本番では誰も許可しない
ALLOWED_EMAILS=

# Google でのログイン(アカウントのページで連結した人だけが使える。Google だけでは、アカウントを作れない)。2 つともそろっているときだけ、Google が使える
# Google Cloud の OAuth クライアント(ウェブ アプリケーション)で作る。承認済みのリダイレクト URI に、http://localhost:3000/api/auth/callback/google と、本番の https://(ドメイン)/api/auth/callback/google を入れる
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouter(モデル名は環境変数で切り替える)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# ログインのメール(Resend)。開発とテストは、指定が無ければ、メールを送らず、next dev の端末に出す。本番は、RESEND_API_KEY と MAIL_FROM が必須(無いと、ログインのメールを送ろうとしてエラーになる)
# MAIL_FROM のドメインは、Resend で認証したもの(DNS に DKIM などを足す)。MAIL_REPLY_TO は任意(返信が届く、実在する受信箱)
RESEND_API_KEY=
MAIL_FROM=
# MAIL_REPLY_TO=
# 開発で、本物のメールが届くかを確かめるとき(キーと送信元も要る)。ALLOWED_EMAILS が空なら、開発では、どのアドレスにも送れてしまうので、確かめるときは自分のアドレスだけにする
# EMAIL_TRANSPORT=resend

# 食事の AI 推定の、1 日あたりの上限(1 以上の整数)。指定が無いとき: 開発サーバーは上限なし、本番とテストは 20 回
# MEAL_ESTIMATE_DAILY_LIMIT=
